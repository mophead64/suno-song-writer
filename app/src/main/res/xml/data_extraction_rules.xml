<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: API keys (encrypted, and useless without this device's Keystore) are never backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
