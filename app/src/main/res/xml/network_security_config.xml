<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is permitted here because the hosts users configure (Ollama, LM Studio on a LAN or
  Tailscale address) can't be listed ahead of time. The app enforces the real rule on every request:
  plain http:// only for local addresses, https:// for everything else (data/llm/CleartextPolicy.kt).
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Intentional; see above. -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
